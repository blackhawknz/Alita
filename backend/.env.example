# ─── Alita configuration ────────────────────────────────────────────
# Copy to backend/.env. Everything here can also be changed live from the
# Settings page in the UI (which writes this file). Real environment
# variables take precedence over this file at startup.

# ─── Model provider ─────────────────────────────────────────────────
# ollama | openai | anthropic | deepseek | gemini | openrouter | grok | qwen | zai | minimax | liquid | liquid_local | custom
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
# Context length Ollama allocates per request (default 16384)
# OLLAMA_NUM_CTX=16384

# Hosted providers — set the key(s) for the ones you use. Several keys may be
# given comma-separated; Alita rotates on rate limits.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# XAI_API_KEY=...
# GROK_MODEL=grok-4
# DASHSCOPE_API_KEY=...
# QWEN_MODEL=qwen-plus
# ZAI_API_KEY=...
# ZAI_MODEL=glm-4.6
# MINIMAX_API_KEY=...
# MINIMAX_MODEL=MiniMax-M2

# Liquid AI — hosted API (OpenAI-compatible) or fully offline local model.
# Hosted: get a key at https://console.liquid.ai
# LIQUID_API_KEY=...
# LIQUID_MODEL=lfm2.5-1.2b-instruct
# LIQUID_BASE_URL=https://api.liquid.ai/openai/v1
#
# Offline: the GGUF is downloaded once into ~/.alita/models/liquid and then
# runs with no internet or key. Requires llama-cpp-python (in requirements.txt).
# LIQUID_LOCAL_MODEL=LiquidAI/LFM2.5-1.2B-Instruct-GGUF
# LIQUID_LOCAL_FILE=LFM2.5-1.2B-Instruct-Q4_K_M.gguf
# LIQUID_LOCAL_CONTEXT=8192
# LIQUID_LOCAL_THREADS=4
# LIQUID_LOCAL_GPU_LAYERS=0
# Use an already-downloaded GGUF instead of the managed cache:
# LIQUID_LOCAL_PATH=C:\models\LFM2.5-1.2B-Instruct-Q4_K_M.gguf
# Automatically use the offline Liquid model when an online provider has no
# key, no connection, or is rate-limited. Set false to disable.
# ALITA_LIQUID_FALLBACK=true

# Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, LiteLLM ...)
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_MODEL=qwen2.5-coder-32b
# CUSTOM_API_KEY=

# Every provider's endpoint can be overridden with <PROVIDER>_BASE_URL,
# e.g. ZAI_BASE_URL=https://api.z.ai/api/paas/v4 for the international Z.AI.

# ─── Server ─────────────────────────────────────────────────────────
# Loopback by default. Binding 0.0.0.0 requires ALITA_API_TOKEN (or
# ALITA_ALLOW_INSECURE_BIND=true, e.g. inside Docker).
ALITA_HOST=127.0.0.1
ALITA_PORT=8080
ALITA_DEBUG=false
# ALITA_API_TOKEN=change-me          # require "Authorization: Bearer <token>"
# ALITA_CORS_ORIGINS=http://localhost:3001

# ─── Paths ──────────────────────────────────────────────────────────
# Data (sessions, memory, skills, uploads): ~/.alita by default
# ALITA_HOME=~/.alita
# Directory the file/terminal tools operate in
ALITA_WORKSPACE=./workspace

# ─── Agent behaviour ────────────────────────────────────────────────
# Let terminal / execute_code run on this machine when no Docker sandbox is
# available. Destructive commands still require approval.
# ALITA_ALLOW_HOST_EXEC=false
# ALITA_MAX_ITERATIONS=50            # tool steps per turn
# ALITA_TEMPERATURE=0.7
# ALITA_MAX_OUTPUT_TOKENS=8192
# ALITA_CONTEXT_WINDOW=0             # 0 = detect from model
# ALITA_COMPACTION_THRESHOLD=0.75    # summarise older turns past this fraction
# ALITA_AUTO_TITLE=true

# Memory
# ALITA_MEMORY_AUTO_RECALL=true      # inject relevant memories each turn
# ALITA_MEMORY_AUTO_EXTRACT=true     # learn new facts after each exchange
# ALITA_MEMORY_RECALL_K=6
# ALITA_VECTOR_ENABLED=true          # local embeddings (ChromaDB) for semantic recall

# Skills
# ALITA_SKILLS_AUTO_CREATE=true      # distil complex successful tasks into skills
# ALITA_SKILLS_MIN_TOOL_CALLS=6

# Sub-agents
# ALITA_SUBAGENT_MAX_ITERATIONS=25
# ALITA_SUBAGENT_MAX_DEPTH=2

# Approvals: auto (gate destructive calls) | always | never
# ALITA_APPROVAL_MODE=auto
# ALITA_APPROVAL_TIMEOUT=300
# Background runs (jobs, kanban, sub-agents) can't ask you: deny | allow
# ALITA_HEADLESS_APPROVAL=deny

# ─── Voice ──────────────────────────────────────────────────────────
# Free by default: Microsoft Edge neural voices (the 'edge-tts' package is in
# requirements.txt) — no key needed. The chosen provider and voice live in
# ~/.alita/voice.json and are editable in Settings → Voice.
# Premium: ElevenLabs (per-character credits).
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_MAX_CHARS=2500
# ElevenLabs endpoint override (data residency):
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Cheap: OpenAI speech (uses OPENAI_API_KEY / OPENAI_BASE_URL above).
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ─── Integrations ───────────────────────────────────────────────────
EASY_DIFFUSION_URL=http://localhost:9000
# Gmail: save the OAuth client JSON to ~/.alita/gmail_client_secret.json
# (or set GMAIL_CLIENT_SECRET_PATH), then use Settings → Integrations.
# MCP servers: ~/.alita/mcp_servers.json (see alita/data/mcp_servers.json.example)
# ALITA_MCP_ENABLED=true
# ALITA_KANBAN_MAX_CONCURRENT=2
# ALITA_ALLOW_PRIVATE_URLS=false     # let web tools reach localhost/LAN
