# Alita reads its configuration from backend/.env — see backend/.env.example
# for every option. This file is only used by docker-compose for variable
# substitution (e.g. OLLAMA_BASE_URL, EASY_DIFFUSION_URL).
OLLAMA_BASE_URL=http://host.docker.internal:11434
EASY_DIFFUSION_URL=http://host.docker.internal:9000
